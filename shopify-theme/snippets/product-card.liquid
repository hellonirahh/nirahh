{%- comment -%}
  One saree in a rail or grid.
  Accepts: card_product (a product object).
  Falls back to a placeholder so the theme editor still looks right on a store
  with no products loaded yet.
{%- endcomment -%}
<article class="product">
  {%- if card_product == blank -%}
    <a class="product-media" href="#">
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </a>
    <h3>{{ 'onboarding.product_title' | t }}</h3>
    <p class="product-meta">Handwoven linen</p>
    <p class="price">{{ 6548 | times: 100 | money }}</p>
  {%- else -%}
    <a class="product-media" href="{{ card_product.url }}">
      {%- if card_product.featured_image -%}
        <img
          src="{{ card_product.featured_image | image_url: width: 900 }}"
          alt="{{ card_product.featured_image.alt | default: card_product.title | escape }}"
          width="900"
          height="1200"
          loading="lazy">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </a>
    <h3><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>
    {%- if card_product.type != blank -%}
      <p class="product-meta">{{ card_product.type | escape }}</p>
    {%- endif -%}
    <p class="price">
      {{ card_product.price | money }}
      {%- unless card_product.available %} &middot; {{ 'products.product.sold_out' | t }}{% endunless -%}
    </p>
    {%- comment -%}
      Outside both links above, so clicking it never navigates the card.
      Hidden while settings.tryon_enabled is off, matching every other entry
      point's default-disabled state (steps 24-27).
    {%- endcomment -%}
    {%- if settings.tryon_enabled -%}
      <button type="button" class="product-try" data-tryon-open
              data-tryon-product-gid="gid://shopify/Product/{{ card_product.id }}"
              data-tryon-variant-gid="gid://shopify/ProductVariant/{{ card_product.selected_or_first_available_variant.id }}"
              data-tryon-title="{{ card_product.title | escape }}"
              data-tryon-url="{{ card_product.url }}"
              {%- if card_product.featured_image %} data-tryon-image="{{ card_product.featured_image | image_url: width: 200 }}"{% endif %}>
        {{ 'products.product.try_on' | t }}
      </button>
    {%- endif -%}
  {%- endif -%}
</article>
