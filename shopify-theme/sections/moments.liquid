<section class="section moments" id="moments">
  <div class="wrap rail-head reveal">
    <div>
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="section-sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="wrap">
    <div class="moment-rail reveal">
      {%- for block in section.blocks -%}
        {%- liquid
          assign moment_collection = collections[block.settings.collection]
          assign moment_image = block.settings.image
          if moment_image == blank and moment_collection.image
            assign moment_image = moment_collection.image
          endif
        -%}
        <a class="moment" href="{{ block.settings.link | default: moment_collection.url | default: '#' }}" {{ block.shopify_attributes }}>
          {%- if moment_image != blank -%}
            <img src="{{ moment_image | image_url: width: 800 }}"
                 alt="{{ moment_image.alt | default: block.settings.heading | escape }}"
                 width="800" height="1000" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <div class="moment-copy">
            <h3>{{ block.settings.heading }}</h3>
            <span class="arrow">&rarr;</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by moment",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by moment"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find the saree for every room you walk into."
    }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Office drapes"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Its image is used unless you choose one below."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photograph"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Overrides the collection link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by moment",
      "blocks": [
        { "type": "moment", "settings": { "heading": "Office drapes" } },
        { "type": "moment", "settings": { "heading": "Boardroom drapes" } },
        { "type": "moment", "settings": { "heading": "Evening drapes" } },
        { "type": "moment", "settings": { "heading": "Travel drapes" } },
        { "type": "moment", "settings": { "heading": "Celebration drapes" } }
      ]
    }
  ]
}
{% endschema %}
