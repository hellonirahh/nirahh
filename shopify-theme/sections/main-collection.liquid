<section class="wrap page-head">
  <h1 class="eyebrow">{% if collection.handle == 'travel' and collection.title == 'Travel' %}Travel drapes{% else %}{{ collection.title | escape }}{% endif %}</h1>
  {%- assign description = collection.description | replace: 'Would I wear this into a room where my work matters?', '' | replace: 'would I wear this into a room where my work matters?', '' | replace: 'Everything here passed one question:', '' -%}
  {%- assign description_text = description | strip_html | strip -%}
  {%- if description_text != blank -%}
    <div class="lead rte">{{ description }}</div>
  {%- endif -%}
</section>

<section class="wrap">
  {%- if collection.products_count > 0 -%}
    {%- paginate collection.products by 24 -%}
      <div class="product-grid">
        {%- for product in collection.products -%}
          {% render 'product-card', card_product: product %}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {{ paginate | default_pagination }}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- else -%}
    <p class="lead center" style="padding-block:3rem">Nothing here yet.</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}
