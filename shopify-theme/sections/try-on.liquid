<section class="section tryon" id="try-on">
  <div class="wrap tryon-grid reveal">
    <div class="tryon-copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="display">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="lead">{{ section.settings.body }}</p>
      {%- endif -%}
      <button class="btn btn-solid" id="tryOnBtn" type="button" data-tryon-open aria-describedby="tryOnNotice">{{ section.settings.button_label }}</button>
      <p class="fineprint" id="tryOnNotice"><strong>Under development — virtual try-on is not available yet.</strong></p>
      {%- if section.settings.fineprint != blank -%}
        <p class="fineprint">{{ section.settings.fineprint }}</p>
      {%- endif -%}
    </div>
    <figure class="tryon-media">
      <div class="phone">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 600 }}"
               alt="{{ section.settings.image.alt | escape }}" width="600" height="1066" loading="lazy">
        {%- else -%}
          <img src="{{ 'moment-celebration.png' | asset_url }}"
               alt="A saree previewed on screen" width="600" height="1066" loading="lazy">
        {%- endif -%}
      </div>
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "See yourself in it",
  "settings": [
    {
      "type": "paragraph",
      "content": "This button opens the one shared fitting-room dialog rendered from layout/theme.liquid (snippets/tryon-dialog.liquid), not a dialog of its own. That shared dialog shows a \"still in the works\" message until the Virtual try-on settings group's \"Enable virtual try-on\" switch is turned on."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "See yourself in it"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "Not sure how it<br>will look on you?"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "We’re developing a private way to see the Nirahh Edit on yourself before you decide."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Try it on"
    },
    {
      "type": "text",
      "id": "fineprint",
      "label": "Fineprint",
      "default": "Photo uploads are not available while this feature is under development."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Phone screen image"
    }
  ],
  "presets": [
    { "name": "See yourself in it" }
  ]
}
{% endschema %}
