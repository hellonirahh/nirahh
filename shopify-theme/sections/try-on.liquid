<section class="section tryon" id="try-on">
  <div class="wrap tryon-grid reveal">
    <div class="tryon-copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="display">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="lead">{{ section.settings.body }}</p>
      {%- endif -%}
      <button class="btn btn-solid" id="tryOnBtn" type="button" aria-describedby="tryOnNotice">{{ section.settings.button_label }}</button>
      <p class="fineprint" id="tryOnNotice"><strong>Under development — virtual try-on is not available yet.</strong></p>
      {%- if section.settings.fineprint != blank -%}
        <p class="fineprint">{{ section.settings.fineprint }}</p>
      {%- endif -%}
    </div>
    <figure class="tryon-media">
      <div class="phone">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 600 }}"
               alt="{{ section.settings.image.alt | escape }}" width="600" height="1066" loading="lazy">
        {%- else -%}
          <img src="{{ 'moment-celebration.png' | asset_url }}"
               alt="A saree previewed on screen" width="600" height="1066" loading="lazy">
        {%- endif -%}
      </div>
    </figure>
  </div>
</section>

<div class="modal" id="tryOnModal" hidden>
  <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="tryOnTitle">
    <button class="modal-close" id="modalClose" aria-label="{{ 'general.close' | t }}" type="button">&times;</button>

    <div class="modal-body">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h3 id="tryOnTitle" class="display">This feature is still in the works.</h3>
      <p class="lead">We're building a private, on-you preview of the Nirahh Edit. It isn't ready to launch just yet — check back soon.</p>
      <div class="modal-actions">
        <a class="btn btn-solid" href="{{ routes.root_url }}#the-edit">Explore the Edit</a>
      </div>
      <p class="fineprint">We'll let you know the moment it's ready.</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "See yourself in it",
  "settings": [
    {
      "type": "paragraph",
      "content": "The try-on backend isn't built yet, so this button opens a \"coming soon\" message rather than the old fake upload-and-preview flow. Swap the modal markup back in once the real rendering service ships."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "See yourself in it"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "Not sure how it<br>will look on you?"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "We’re developing a private way to see the Nirahh Edit on yourself before you decide."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Try it on"
    },
    {
      "type": "text",
      "id": "fineprint",
      "label": "Fineprint",
      "default": "Photo uploads are not available while this feature is under development."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Phone screen image"
    }
  ],
  "presets": [
    { "name": "See yourself in it" }
  ]
}
{% endschema %}
