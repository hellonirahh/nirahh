<section class="pillars-band reveal">
  <div class="wrap pillars">
    {%- for block in section.blocks -%}
      <article class="pillar" {{ block.shopify_attributes }}>
        {%- case block.settings.icon -%}
          {%- when 'circle' -%}
            <svg class="pillar-icon" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="9"/><path d="M16 7v18"/></svg>
          {%- when 'drape' -%}
            <svg class="pillar-icon" viewBox="0 0 32 32" aria-hidden="true"><path d="M8 6c3 6 3 14 0 20"/><path d="M16 6c3 6 3 14 0 20"/><path d="M24 6c3 6 3 14 0 20"/></svg>
          {%- else -%}
            <svg class="pillar-icon" viewBox="0 0 32 32" aria-hidden="true"><path d="M6 26c0-9 7-16 20-18-2 13-9 18-20 18z"/><path d="M6 26c4-5 8-8 13-10"/></svg>
        {%- endcase -%}
        <h3>{{ block.settings.heading }}</h3>
        <p>{{ block.settings.body }}</p>
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Pillars",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "circle", "label": "Circle" },
            { "value": "drape", "label": "Drape" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Light fabrics"
        },
        {
          "type": "text",
          "id": "body",
          "label": "Body",
          "default": "For long days"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pillars",
      "blocks": [
        { "type": "pillar", "settings": { "icon": "leaf", "heading": "Light fabrics", "body": "For long days" } },
        { "type": "pillar", "settings": { "icon": "circle", "heading": "Quiet colours", "body": "Presentable always" } },
        { "type": "pillar", "settings": { "icon": "drape", "heading": "Considered drapes", "body": "Comfort in every moment" } }
      ]
    }
  ]
}
{% endschema %}
